# Copy this file to `.env` and uncomment the line for your setup.
# `.env` is git-ignored — never commit it.

# --- Android emulator (AVD) ---
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000

# --- Physical device, same Wi-Fi ---
# Use your machine's LAN IP. 127.0.0.1 on a phone points to the PHONE
# itself, not the backend — that is why number checks used to fail.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000

# --- Production (Hugging Face Space) ---
# EXPO_PUBLIC_API_URL=https://l-law-liet-fraudguard-pk-backend.hf.space
