# Is file ko `.env` naam se copy karein (`.env` git me track NAHI hoti).
#
# Backend URL. Apni situation ke hisaab se ek line uncomment karein:
#
#   Android emulator (AVD) ->   machine ka localhost
#   Physical Android phone ->   machine ka LAN IP (127.0.0.1 phone KHUD hota
#                                hai, backend nahi — is liye number checks
#                                fail hote thay)
#   Production / real device -> deployed backend
#
# NOTE: `EXPO_PUBLIC_*` values app ke andar bundle hoti hain — yahan KABHI koi
# secret key (Gemini, AssemblyAI, database) na rakhein.

# --- Android emulator ---
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000

# --- Physical device, same Wi-Fi ---
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000

# --- Live server (Render) ---
# EXPO_PUBLIC_API_URL=https://fraud-detector-kno0.onrender.com
