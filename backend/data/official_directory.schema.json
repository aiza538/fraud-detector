{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultiRegionOfficialDirectory",
  "description": "Verified multi-region directory of official Pakistani and international institutions, global tech platforms, couriers, and authorities.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_version": {
      "type": "string"
    },
    "_about": {
      "type": "string"
    },
    "_provenance": {
      "type": "string"
    },
    "_last_updated": {
      "type": "string"
    },
    "regions": {
      "type": "object",
      "required": ["PK", "GLOBAL", "AE", "UK"],
      "properties": {
        "PK": {
          "type": "object",
          "required": ["region_name", "entities"]
        },
        "GLOBAL": {
          "type": "object",
          "required": ["region_name", "entities"]
        },
        "AE": {
          "type": "object",
          "required": ["region_name", "entities"]
        },
        "UK": {
          "type": "object",
          "required": ["region_name", "entities"]
        }
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/entity"
      }
    },
    "_revoked_or_fraud_alerts": {
      "type": "object"
    }
  },
  "definitions": {
    "entity": {
      "type": "object",
      "required": [
        "name",
        "category",
        "website",
        "web_endpoints",
        "uans",
        "shortcodes",
        "numbers"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Official entity display name"
        },
        "category": {
          "type": "string",
          "enum": [
            "commercial_bank",
            "digital_wallet",
            "law_enforcement",
            "government_agency",
            "regulatory_body",
            "telecom_operator",
            "global_tech",
            "international_courier"
          ]
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "web_endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "auth_headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shortcodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "numbers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified_on": {
          "type": ["string", "null"]
        },
        "note": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["verified", "pending_review"]
        }
      }
    }
  }
}
