{
  "manifest_version": 3,
  "name": "FraudGuard PK",
  "version": "1.0.0",
  "description": "AI-powered scam detection for WhatsApp, X, and LinkedIn.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "FraudGuard PK"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.whatsapp.com/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://*.onrender.com/*"
  ]
}
